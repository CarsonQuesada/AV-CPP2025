<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schemaVersion="3.0"?>
<package format="3">
  <name>computer_vision</name>
  <version>0.1.0</version>
  <description>Computer vision node for object detection using YOLO</description>
  
  <maintainer email="carsonpquesada@gmail.com">avcpp</maintainer>
  <license>Apache License 2.0</license>
  
  <buildtool_depend>ament_cmake</buildtool_depend>
  
  <depend>rclcpp</depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>
  <depend>cv_bridge</depend>
  <depend>opencv</depend>
  <depend>rclcpp_components</depend>
  
  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
