{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build Pi Server Debug",
            "type": "shell",
            "command": "g++",
            "args": [
                "-std=c++17",
                "-DDEBUG",
                "-I${workspaceFolder}",
                "-I${workspaceFolder}/PiServer/src",  
                "-g", 
                "-Wall",
                "${workspaceFolder}/PiServer/src/*.cpp",
                "${workspaceFolder}/PiServer/src/**/*.cpp",
                "-o",
                "${workspaceFolder}/PiServer/build/debug/PiServer",
                "-L/usr/lib",
                "-lpigpiod_if2"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": ["$gcc"],
            "detail": "Build the PiServer project for debugging"
        },
        {
            "label": "Build PiServer Release",
            "type": "shell",
            "command": "g++",
            "args": [
                "-O2",
                "-Wall",
                "${workspaceFolder}/AV/PiServer/*.cpp",
                "-o",
                "${workspaceFolder}/AV/build/PiServer/release"
            ],
            "group": {
                "kind": "build",
                "isDefault": false
            },
            "problemMatcher": ["$gcc"],
            "detail": "Build the entire project with optimizations"
        },
        {
            "label": "Build TCP Client Debug",
            "type": "shell",
            "command": "g++",
            "args": [
                "-DDEBUG",
                "-std=c++17",
                "${workspaceFolder}/TCPClient/src/*.cpp",
                "${workspaceFolder}/TCPClient/src/Communication/*.cpp",
                "-I${workspaceFolder}",
                "-I${workspaceFolder}/TCPClient/src",              
                "-o", 
                "${workspaceFolder}/TCPClient/build/debug/TCPClient.exe",
                "-static",               // Fully static linking
                "-static-libgcc",        // Static link libgcc
                "-static-libstdc++",     // Static link libstdc++
                "-lWs2_32",   // Link the Winsock library
                "-ldinput8",  // Link the DirectInput library
                "-ldxguid"    // Link the DirectX GUID library
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": ["$gcc"],
            "detail": "Generated task to build TCP Client"
        }
    ]
}