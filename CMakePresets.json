{
  "version": 6,
  "configurePresets": [
    {
      "name": "win-tcpclient-debug",
      "displayName": "Windows MinGW - TCPClient Debug (MJPEG only)",
      "generator": "MinGW Makefiles",
      "binaryDir": "${sourceDir}/build/win-tcpclient-debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "DEPS_FORCE_FETCH": "OFF",
        "ENABLE_RTSP": "OFF"
      }
    },
    {
      "name": "win-tcpclient-rtsp",
      "displayName": "Windows MinGW - TCPClient Debug (RTSP enabled)",
      "generator": "MinGW Makefiles",
      "binaryDir": "${sourceDir}/build/win-tcpclient-rtsp",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "DEPS_FORCE_FETCH": "OFF",
        "ENABLE_RTSP": "ON",
        "FFMPEG_ROOT": "${sourceDir}/TCPClient/Dependencies/ffmpeg",
        "FFMPEG_COPY_DLLS": "ON"
      }
    },
    {
      "name": "vehicle-debug",
      "displayName": "Vehicle - Debug",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/vehicle-debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    }
  ],
  "buildPresets": [
    { "name": "win-tcpclient-debug", "configurePreset": "win-tcpclient-debug" },
    { "name": "win-tcpclient-rtsp",  "configurePreset": "win-tcpclient-rtsp"  },
    { "name": "vehicle-debug",       "configurePreset": "vehicle-debug" }
  ],
  "workflowPresets": [
    {
      "name": "tcpclient",
      "steps": [
        { "type": "configure", "name": "win-tcpclient-debug" },
        { "type": "build",     "name": "win-tcpclient-debug" }
      ]
    }
  ]
}
